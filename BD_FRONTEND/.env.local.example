# Frontend environment template. Copy to .env.local (git-ignored) and adjust.
# Public values only: NEXT_PUBLIC_* is embedded in the browser bundle, so never put secrets here.

# Base URL of the FastAPI backend, as the browser reaches it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional, server-side only (no NEXT_PUBLIC_, never sent to the browser): address the Next.js
# server uses to call the backend. Needed in Docker, where the API is not at localhost
# (for example http://api:8000). When unset or empty, NEXT_PUBLIC_API_BASE_URL is used.
# API_INTERNAL_URL=http://localhost:8000

# Playwright journeys only (npm run test:e2e), server-side, never sent to the browser. Use FAKE
# test accounts that already exist in a local or test database, never real users or passwords.
# E2E_BASE_URL=http://localhost:3000
# E2E_REP_EMAIL=rep-e2e@example.test
# E2E_REP_PASSWORD=replace-with-the-fake-rep-password
# E2E_ADMIN_EMAIL=admin-e2e@example.test
# E2E_ADMIN_PASSWORD=replace-with-the-fake-admin-password
