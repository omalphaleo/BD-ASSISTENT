# Native (non-Docker) run: copy to BD_BACKEND/.env (git-ignored) and fill in.
# SQLAlchemy URL form: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Optional: development | test | production (default: development)
APP_ENV=

# Session cookie settings (defaults shown; uncomment to override)
# Session lifetime in hours.
# SESSION_LIFETIME_HOURS=12
# Name of the session cookie.
# SESSION_COOKIE_NAME=bd_session
# Secure cookie flag. Use false only for local plain-HTTP; must be true in production.
# SESSION_COOKIE_SECURE=true
# Exact frontend origin: scheme and host, optional port, no trailing slash or path.
# FRONTEND_ORIGIN=http://localhost:3000

# Import uploads (M2-A1; defaults shown). UPLOAD_DIR must be one persistent directory that the
# API and the worker both use. Native runs need a writable path, for example ./uploads.
# UPLOAD_DIR=/srv/uploads
# UPLOAD_MAX_BYTES=20971520
# UPLOAD_MAX_ROWS=50000
# XLSX_MAX_ENTRIES=1000
# XLSX_MAX_MEMBER_BYTES=104857600
# XLSX_MAX_TOTAL_BYTES=209715200
# XLSX_MAX_COMPRESSION_RATIO=100

# Import processing (M2-A3; defaults shown): rows per transaction, and the cooling-off days
# handed to ingest_row (D-082).
# IMPORT_CHUNK_SIZE=500
# COOLING_OFF_DAYS=90
