      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/.next/**)",
      "Read(./**/.venv/**)",
      "Read(./**/venv/**)",
