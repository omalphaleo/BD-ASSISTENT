# Used by docker-compose.yml. Copy to .env and fill in (.env is git-ignored).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Session cookie settings (defaults shown; uncomment to override)
# Session lifetime in hours.
# SESSION_LIFETIME_HOURS=12
# Name of the session cookie.
# SESSION_COOKIE_NAME=bd_session
# Secure cookie flag. Use false only for local plain-HTTP; must be true in production.
# SESSION_COOKIE_SECURE=true
# Exact frontend origin: scheme and host, optional port, no trailing slash or path.
# FRONTEND_ORIGIN=http://localhost:3000

# Login throttling (defaults shown; uncomment to override). Failed logins allowed inside the
# rolling window before further attempts are rejected with the usual 401.
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_THROTTLE_WINDOW_MINUTES=15

# AI natural-language search (M3-A6). Leave the key empty to run without AI: structured search
# keeps working and the NL box shows "AI unavailable". This is the free-tier development key,
# for hand-selected test data only (D-061, D-062); a paid tier is required before any real
# prospect data. The api container also needs it passed through docker-compose.yml
# (see milestone/m3.md section 31).
GEMINI_API_KEY=
# AI_TIMEOUT_SECONDS=10
# AI_MAX_RETRIES=2
